# Copia este archivo como .env.local (en local) y crea las mismas variables en Vercel
# (Project → Settings → Environment Variables).

# API key de Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente. Debe ser de un dominio verificado en Resend (https://resend.com/domains).
# Mientras no verifiques tu dominio, usa onboarding@resend.dev: en ese modo Resend
# solo entrega correos a la dirección dueña de la cuenta de Resend.
RESEND_FROM_EMAIL="Arándino <onboarding@resend.dev>"

# Bandeja del equipo que recibe distribuidores, reseñas, avisos y suscripciones.
CONTACT_TO_EMAIL=tu-correo@ejemplo.com
